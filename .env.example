# ====================================================================
# INDIAN MAGICIAN - ENVIRONMENT CONFIGURATION
# ====================================================================

# Port for the Node.js Express server
PORT=5001

# ====================================================================
# EMAIL NOTIFICATIONS SETUP (Choose either Gmail SMTP or custom SMTP)
# ====================================================================
# When someone submits an inquiry on the website (Footer or Contact page),
# the server will automatically send an email to your inbox.

# 1. For Gmail:
#   - SMTP_HOST: smtp.gmail.com
#   - SMTP_PORT: 465
#   - SMTP_USER: your-email@gmail.com
#   - SMTP_PASS: your 16-character Google App Password (NOT your regular password)
#     (To get this: Go to myaccount.google.com -> Security -> 2-Step Verification -> App Passwords)
#
# 2. Destination email where you want to receive inquiries:
#   - NOTIFICATION_EMAIL: your-email@gmail.com (defaults to indianmagician.upendra@gmail.com)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
NOTIFICATION_EMAIL=indianmagician.upendra@gmail.com
